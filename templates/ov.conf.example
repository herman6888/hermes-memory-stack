{
  "storage": {
    "workspace": "/app/.openviking/data"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "root_api_key": "<REDACTED: 生成一个强随机 key>"
  },
  "embedding": {
    "dense": {
      "provider": "openai",
      "model": "<REPLACE: embedding 模型名>",
      "api_base": "<REPLACE: http://<LLM_HOST>:<PORT>/v1>",
      "api_key": "<REPLACE>",
      "dimension": 2560,
      "input": "text"
    }
  },
  "vlm": {
    "provider": "openai",
    "model": "<REPLACE: 对话模型名>",
    "api_key": "<REPLACE>",
    "api_base": "<REPLACE: http://<LLM_HOST>:<PORT>/v1>",
    "temperature": 0.0,
    "max_retries": 2,
    "extra_request_body": {
      "num_ctx": 16384,
      "think": false
    }
  }
}
