# 复制为 .env 后填写。所有脚本和 compose 都读这个文件。
# ---- 基础 ----
TZ=Asia/Hong_Kong
STACK_DATA_DIR=./.stack-data
# ---- Postgres (gbrain 素材层) ----
PG_USER=brain
PG_PASSWORD=***
PG_PORT=5434
# ---- OpenViking (语义索引) ----
OV_PORT=1933
OV_DATA_DIR=$HOME/.hermes/.local/share/openviking
# ---- 模型端点（本地 LM Studio / llama.cpp / 任意 OpenAI 兼容端点）----
EMBED_BASE_URL=http://REPLACE_ME:1234/v1
EMBED_MODEL=REPLACE_ME                      # 例：text-embedding-qwen3-embedding-4b-i1
EMBED_DIM=2560                              # 改维度=换索引，需重建
CHAT_BASE_URL=http://REPLACE_ME:8731/v1
CHAT_MODEL=REPLACE_ME
# ---- 仓库 ----
GBRAIN_REPO_URL=https://github.com/REPLACE_ME/brain-workspace.git      # 私有：工作区页面
GBRAIN_UPSTREAM_URL=https://github.com/garrytan/gbrain              # gbrain 上游
BACKUP_REPO_URL=https://github.com/REPLACE_ME/brain-backup.git      # 私有：加密备份
GIT_CRYPT_KEY=$HOME/.ssh/git-crypt-backup.key
# ---- 备份告警投递（hermes cron --failure-deliver 语法，如 feishu:<chat_id>）----
BACKUP_ALERT_TARGET=local
# ---- 备份参数 ----
BACKUP_LOCAL_DIR=$HOME/Projects/brain-backup
POSTGRES_CONTAINER=brain-postgres
WEEKLY_KEEP=6
DAILY_KEEP_DAYS=30
